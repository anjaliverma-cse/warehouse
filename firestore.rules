rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasWorkspaceRole() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // New self-registered accounts are staff by default. Promote trusted admins manually in Firebase Console.
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'staff';
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    match /workspaces/{workspaceId} {
      allow read, write: if hasWorkspaceRole() && workspaceId == 'main';
    }
  }
}
